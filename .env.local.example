# ──────────────────────────────────────────────────────────────────────────────
# PM-Web_V2 — environment template
#
# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored; this template is committed on purpose so the list
# of required variables can't rot. Every variable below is read somewhere in the
# codebase — nothing speculative.
#
# Status legend
#   [now]     needed to run the site locally today (with real content)
#   [v2.9.0]  needed by the authentication work (Phases 1–5)
#   [deploy]  only relevant once the site is deployed somewhere
#
# Anything left empty degrades gracefully: no Notion token = empty listings,
# no Turnstile keys = Cloudflare's dev test keys, no GitHub id/secret = the
# provider is not registered. Only a real deployment needs real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────

# [now] Public origin. Used for metadata/canonical URLs and by better-auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Notion CMS ───────────────────────────────────────────────────────────────
# Content (projects, blog, articles, tutorials, glossary) is served from Notion.
# Create an internal integration and share each database with it:
#   notion.so/my-integrations → New integration → copy the secret
# Then share the databases with the integration inside Notion (••• → Connections).

# [now] Integration secret. Either name works; NOTION_API_KEY takes precedence.
NOTION_API_KEY=
# NOTION_AUTH_TOKEN=

# [now] Target databases / pages (share each one with the integration above).
NOTION_PROJECTS_ID=
NOTION_BLOG_ID=
NOTION_ARTICLES_ID=
NOTION_TUTORIALS_ID=
NOTION_GLOSSARY_ID=
# NOTION_WIKI_ID=          # legacy fallback name for the glossary database
NOTION_AUTHORS_ID=

# Optional overrides (defaults live in lib/notion-cms.ts).
# NOTION_API_VERSION=
# NOTION_PUBLISHED_STATUS=Published

# ── Comments (Cloudflare Turnstile) ──────────────────────────────────────────
# Guest comments are stored as native Notion comments on the page; Turnstile is
# the bot gate. The NOTION_* variables above must be set for comments to work.
# Full details: docs/comments-system.md and docs/comments.env.example.

# [deploy] https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional tuning — defaults are in lib/comments/config.ts.
# COMMENTS_ENABLED=true          # "false" stops new comments, reads keep working
# COMMENTS_STORE_EMAIL=true      # store the raw email so you can reply
# COMMENTS_RATE_LIMIT=3          # per IP, per window
# COMMENTS_RATE_WINDOW_MS=60000
# COMMENTS_DAILY_LIMIT=12
# COMMENTS_AVATAR_TIMEOUT_MS=3000

# ── Contact form ─────────────────────────────────────────────────────────────
# /api/contact forwards submissions to a Telegram chat. Leave empty to disable.

# [now] https://core.telegram.org/bots#how-do-i-create-a-bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# [now] Phase 1. Full walkthrough: docs/database-setup.md
# Use the TRANSACTION POOLER (port 6543) — not the direct 5432 URI — or
# connection limits bite as soon as two requests overlap.
#   Supabase → Project → Connect → Transaction pooler
# The driver is `postgres.js` with `prepare: false` (see lib/db/index.ts), which
# the transaction pooler requires. Apply the schema with:  pnpm db:migrate

DATABASE_URL=

# ── Better Auth ──────────────────────────────────────────────────────────────
# [now] Phase 2. Setup guide: docs/auth-setup.md
# Required: the server will not start without these, and reports every missing
# key at once. Generate the secret with:   openssl rand -base64 32
# BETTER_AUTH_URL must match BOTH the origin you browse and the host registered
# on the OAuth app's callback URL (below). No trailing slash.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth: GitHub (the only provider enabled) ────────────────────────────────
# [now] Phase 2. github.com → Settings → Developer settings → OAuth Apps →
# New OAuth App:
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/callback/github
# Both values must be present or the provider simply isn't registered — the site
# still builds and runs without them.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Extra origins allowed to start a sign-in (better-auth's CSRF
# boundary). Leave empty for localhost. Only set this to test from a phone via a
# tunnel — and then also update the OAuth app's callback URL, reverting both
# afterwards. A LAN address (http://192.168.x.x:3000) is refused by design.
#AUTH_TRUSTED_ORIGINS=https://random-words.trycloudflare.com

# ── Registration gate (one seat, then registration closes) ───────────────────
# [now] Phase 2. There is NO environment variable for the seat limit: the
# `site_settings` row in the database is the single source of truth, exactly as
# requested ("the allowable user count should be changeable in the DB").
# Change the ceiling with SQL — no redeploy, no restart:
#
#   UPDATE site_settings SET max_users = 3 WHERE id = 'primary';
#   UPDATE site_settings SET signup_enabled = false WHERE id = 'primary';
#
# The row is created automatically on the first sign-up attempt; before that a
# freshly migrated database behaves as if `max_users = 1`. Details and the
# "existing accounts always sign in" guarantee: docs/auth-setup.md § 5.

# ── Deployment-only changes ──────────────────────────────────────────────────
# [deploy] When you deploy: replace BETTER_AUTH_URL and NEXT_PUBLIC_SITE_URL with
# the production origin and add the production callback URL to the GitHub OAuth
# app (keeping the localhost one for development). Nothing else in v2.9.0 needs a
# deployed environment. Full checklist: docs/deployment.md
