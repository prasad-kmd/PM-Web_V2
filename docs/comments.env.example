# ─────────────────────────────────────────────────────────────────────────────
# Comments subsystem — environment variables
# Copy the keys you need into your existing .env.local / deployment env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so a change
# here requires a rebuild, not just a restart.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Notion: the integration that owns NOTION_API_KEY must be invited to every
# page that should accept comments, and needs the "Read content" +
# "Insert comments" capabilities.
# (Already used by the CMS — listed here only for completeness.)
NOTION_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Kill switch: set to "false" to stop new comments while keeping reads working.
# COMMENTS_ENABLED=true

# Store a SHA-256 prefix instead of the raw address inside the Notion comment.
# Default is to store the raw email so you can reply to commenters.
# COMMENTS_STORE_EMAIL=true

# Rate limits, keyed by client IP.
# COMMENTS_RATE_LIMIT=3
# COMMENTS_RATE_WINDOW_MS=60000
# COMMENTS_DAILY_LIMIT=12

# Outbound budget for each social-avatar lookup, in ms.
# COMMENTS_AVATAR_TIMEOUT_MS=3000

# ── Development note ────────────────────────────────────────────────────────
# When NODE_ENV=development and these keys are empty, the code falls back to
# Cloudflare's published always-pass test keys:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# In production a missing secret causes every submission to be rejected.
